    "@prisma/client": "^6.5.0",
    "@rcs/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "5.2.1",
    "image-size": "^1.2.0",
    "markdown-it": "^14.1.0",
    "openai": "^4.89.0",
    "reflect-metadata": "^0.2.2",
