DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rednote_studio?schema=public"

PORT=18472
CORS_ORIGIN="http://localhost:18473"
# 编辑台的访问地址，外部 Agent 交稿后据此给出打开链接；不填时取 CORS_ORIGIN 的第一个
WEB_ORIGIN="http://localhost:18473"
# 打包后的前端目录；不填则自动找 apps/web/dist，有 index.html 就由后端一起托管
# WEB_DIST="../web/dist"

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="30d"

# 初始管理员，仅在首次启动且用户表为空时创建
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# 转存图片的存放目录与对外访问前缀
STORAGE_DIR="./storage"
STORAGE_PUBLIC_PREFIX="/static"

# 大模型接入走 OpenAI 兼容协议，换厂商只改这三项
# DeepSeek: https://api.deepseek.com/v1
# 通义：https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"

# AI 封面图走 Gemini 生图（Nano Banana），只有 GEMINI_API_KEY 必填
# 国内连 Google 需要代理：GEMINI_PROXY 不填时用 HTTPS_PROXY；也可以把 GEMINI_BASE_URL 换成可用的反代地址
GEMINI_API_KEY=""
GEMINI_PROXY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image-preview"
# 512 / 1K / 2K / 4K
GEMINI_IMAGE_SIZE="2K"
# high 质量更好但慢；minimal 更快；留空则不传
GEMINI_IMAGE_THINKING="high"
