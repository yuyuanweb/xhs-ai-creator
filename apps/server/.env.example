DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rednote_studio?schema=public"

PORT=18472
CORS_ORIGIN="http://localhost:18473"
# 编辑台的访问地址，外部 Agent 交稿后据此给出打开链接；不填时取 CORS_ORIGIN 的第一个
WEB_ORIGIN="http://localhost:18473"

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="30d"

# 初始管理员，仅在首次启动且用户表为空时创建
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# 转存图片的存放目录与对外访问前缀
STORAGE_DIR="./storage"
STORAGE_PUBLIC_PREFIX="/static"

# 大模型接入走 OpenAI 兼容协议，换厂商只改这三项
# DeepSeek: https://api.deepseek.com/v1
# 通义：https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"
